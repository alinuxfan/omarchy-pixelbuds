[Unit]
Description=pixelbudsd Pixel Buds Pro daemon
# The Maestro RFCOMM link needs BlueZ and a session bus, both of which arrive with the graphical session.
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
Environment=RUST_LOG=warn
ExecStart=%h/.local/bin/pixelbudsd
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target
